                    <ui:Image name="Pip3" enabled="true" source="project://database/Assets/UI%20Toolkit/UISprites/Untitled_Artwork-1_4(2).png?fileID=2800000&amp;guid=582779c80fc0a6848adefd5232a1f896&amp;type=3#Untitled_Artwork-1_4(2)" class="pip" style="width: 100px; height: 100px; background-image: none; align-items: center; padding-right: 0; padding-left: 0; display: flex; visibility: visible;"/>
                    <ui:Image name="Pip4" enabled="true" source="project://database/Assets/UI%20Toolkit/UISprites/Untitled_Artwork-1_4(2).png?fileID=2800000&amp;guid=582779c80fc0a6848adefd5232a1f896&amp;type=3#Untitled_Artwork-1_4(2)" class="pip" style="width: 100px; height: 100px; background-image: none; align-items: center; padding-right: 0; padding-left: 0; display: flex; visibility: visible;"/>
                    <ui:Image name="Pip5" enabled="true" source="project://database/Assets/UI%20Toolkit/UISprites/Untitled_Artwork-1_4(2).png?fileID=2800000&amp;guid=582779c80fc0a6848adefd5232a1f896&amp;type=3#Untitled_Artwork-1_4(2)" class="pip" style="width: 100px; height: 100px; background-image: none; align-items: center; padding-right: 0; padding-left: 0; display: flex; visibility: visible;"/>
                </ui:VisualElement>
