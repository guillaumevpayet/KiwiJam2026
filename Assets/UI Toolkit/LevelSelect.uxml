<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/Menu.uss?fileID=7433441132597879392&amp;guid=ca0b5595faa82cf42a88233f482148f6&amp;type=3#Menu"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UI%20Background/TitleBackground.renderTexture?fileID=8400000&amp;guid=b135372d15b13a248a23b8b1c1ee54ab&amp;type=2#TitleBackground&quot;);">
        <ui:Label text="Select Level" name="Title" class="title" style="font-size: 100px; -unity-text-align: upper-center; visibility: hidden;"/>
        <ui:VisualElement name="LevelHolder" style="flex-grow: 1; flex-wrap: wrap;">
            <ui:Button text="Level 1" name="Level1" class="button"/>
            <ui:Button text="Level 2" name="Level2" class="button"/>
            <ui:Button text="Level 3" name="Level3" class="button"/>
            <ui:Button text="Level 4" name="Level4" class="button"/>
            <ui:Button text="Return to Menu" name="Return" class="button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
